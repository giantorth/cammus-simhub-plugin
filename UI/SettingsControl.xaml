<UserControl x:Class="CammusPlugin.UI.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="640" d:DesignHeight="640"
             Background="#1F1F1F"
             Foreground="#E0E0E0"
             FontFamily="Segoe UI"
             FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Cammus Control"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <!-- Status pill: colored ellipse + label, updated by code-behind on a timer. -->
        <Border Grid.Row="1"
                Background="#2A2A2A"
                CornerRadius="14"
                Padding="10,6"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot"
                         Width="10" Height="10"
                         Fill="#888888"
                         VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText"
                           Text="Not connected"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="Detected wheel:" Foreground="#888888"/>
            <TextBlock x:Name="ModelText"
                       Text="—"
                       FontSize="16"
                       Margin="0,2,0,16"/>

            <TextBlock Text="Last sent (LEDs lit / velocity kph / gear):"
                       Foreground="#888888"/>
            <TextBlock x:Name="TelemetryText"
                       Text="—"
                       FontFamily="Consolas"
                       Margin="0,2,0,16"/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="TestButton"
                        Content="Send test pattern (5 LEDs, 60 kph, gear 3)"
                        Padding="14,6"
                        Click="OnTestButtonClick"/>
                <Button x:Name="RefreshDevicesButton"
                        Content="Refresh USB devices"
                        Padding="14,6"
                        Margin="10,0,0,0"
                        Click="OnRefreshDevicesClick"/>
            </StackPanel>
        </StackPanel>

        <!-- USB / HID device enumeration: HidSharp list + Windows registry scan. -->
        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="USB / HID devices"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="DevicesText"
                     Text="Click &quot;Refresh USB devices&quot; to scan."
                     Height="180"
                     IsReadOnly="True"
                     Background="#161616"
                     BorderBrush="#333333"
                     BorderThickness="1"
                     Foreground="#C8C8C8"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="8"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
        </StackPanel>

        <!-- Live HID / diagnostics log mirrored from CammusLog's ring buffer. -->
        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="HID log"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <CheckBox x:Name="AutoScrollCheck"
                              Content="Auto-scroll"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Foreground="#C8C8C8"/>
                    <Button x:Name="CopyLogButton"
                            Content="Copy"
                            Padding="10,3"
                            Margin="10,0,0,0"
                            Click="OnCopyLogClick"/>
                    <Button x:Name="ClearLogButton"
                            Content="Clear"
                            Padding="10,3"
                            Margin="8,0,0,0"
                            Click="OnClearLogClick"/>
                </StackPanel>
            </DockPanel>

            <TextBox x:Name="LogText"
                     Grid.Row="1"
                     MinHeight="140"
                     IsReadOnly="True"
                     Background="#161616"
                     BorderBrush="#333333"
                     BorderThickness="1"
                     Foreground="#C8C8C8"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="8"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
        </Grid>
    </Grid>
</UserControl>
